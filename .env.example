# ======================
# Redigo Logistics Wizard v1.2
# ======================

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=redigo_v12
DB_USER=redigo
DB_PASSWORD=changeme
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=30000
DB_IDLE_TIMEOUT=30000

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication (REQUIRED in production)
JWT_SECRET=change-me-in-production
# JWT_EXPIRES_IN=1h

# CORS
ALLOWED_ORIGINS=http://localhost:8090

# Rate Limiting (requests per minute)
# RATE_LIMIT_AUTH=10
# RATE_LIMIT_API=200
# RATE_LIMIT_WEBHOOK=60

# SAP HTTP Connection (fallback — DB'de process_configs yoksa kullanilir)
# Her company_code icin farkli SAP sistemi UI'dan konfigure edilebilir.
SAP_API_BASE_URL=https://sap-server.local/sap/opu/odata/sap

# Logging
LOG_LEVEL=info

# Sentry (Error Tracking)
# SENTRY_DSN=https://xxx@sentry.io/xxx
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Cron Schedules
CRON_DELIVERY_INGEST=*/5 * * * *
CRON_RECONCILIATION=0 3 * * *
CRON_ARCHIVE_DAYS=90
